          "scope": {
            "type": "string",
            "enum": [
              "project-agents",
              "project-memory",
              "user-memory"
            ],
            "description": "Which scope to search. Defaults to project-memory."
          },
          "force": {
            "type": "boolean",
            "description": "Required — authorizes deleting every memory matching the query. Recorded in the audit log."
          }
        },
        "required": [
          "query",
          "force"
        ],
        "additionalProperties": false
      },
      "otherKeys": [
        "capabilities",
        "category",
        "icon",
        "timeoutMs",
        "usageHint"
      ]
    },
    {
      "name": "memory_update",
      "description": "Update a single SAGE entry by id — edit text, tags, kind, anchors, importance/confidence, status, or relationships.",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The memory id to update."
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "Revision read before correcting the memory; rejects concurrent changes."
          },
          "sources": {
            "type": "array",
            "maxItems": 16,
            "description": "Evidence actually inspected. Use session for agent observations; user only for explicit user statements.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "user",
                    "session",
                    "tool_result",
                    "project_instruction",
                    "file",
                    "test",
                    "command",
                    "legacy_memory"
                  ],
                  "description": "Evidence origin."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Source file or test path."
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Command actually run."
                },
                "toolUseId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Observed tool call id."
                },
                "excerptHash": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Hash of inspected evidence, if available."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "validity": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement"
                ],
                "description": "When this claim applies. Assumptions are unverified until checked in the current task. Literal source checks are evidence signals, not proof that all assumptions hold. Never include secrets or executable commands.",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "checks": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "path",
                        "text"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "source_contains"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "description": "Relative project file path."
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400,
                          "description": "Exact source literal expected while the claim applies; not a regex."
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Replace applicability assumptions; null clears them. Use expectedRevision after checking current evidence."
          },
          "feedback": {
            "type": "object",
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "useful",
                  "outdated",
                  "incorrect",
                  "irrelevant",
                  "uncertain"
                ],
                "description": "Your evidence-based judgment after using/checking this memory."
              },
              "observedRevision": {
                "type": "integer",
                "minimum": 1,
                "description": "Revision you actually read."
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Concrete outcome or current source/test evidence. Do not include secrets or raw logs."
              }
            },
            "required": [
              "verdict",
              "observedRevision",
              "evidence"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Replacement text."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Replacement tags (omit the #)."
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "decision",
              "convention",
              "preference",
              "warning",
              "anti_pattern",
              "workflow",
              "bug_root_cause",
              "file_note",
              "symbol_note",
              "command_note",
              "summary",
              "memory_review",
              "tool_outcome",
              "error_pattern",
              "session_digest",
              "role_operational",
              "task_outcome",
              "security_signal",
              "fleet_convention"
            ],
            "description": "New kind."
          },
          "anchors": {
            "type": "array",
            "description": "Bind this memory to concrete code locations so it can be verified and auto-surfaced.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "file",
                    "directory",
                    "symbol",
                    "package",
                    "command",
                    "test",
                    "git",
                    "agent"
                  ],
                  "description": "Anchor kind."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Project-relative path (required for file/directory/package/test/git)."
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Symbol name (required for symbol anchors)."
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Shell command (required for command anchors)."
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Roster/catalog role id (required for agent anchors)."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "audience": {
            "type": "object",
            "description": "Optional automatic-injection audience. Values are stable project role/task/mode ids.",
            "properties": {
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Agent role ids, for example reviewer, refactor-planner, or git."
              },
              "taskTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Task classifications such as review, refactor, or bugfix."
              },
              "modes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Runtime mode ids."
              }
            },
            "additionalProperties": false
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "freshness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "persistence": {
            "type": "string",
            "enum": [
              "permanent",
              "long_lived",
              "short_lived"
            ],
            "description": "Retention class. Prefer long_lived; permanent is only for explicit invariants."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "stale",
              "superseded",
              "contradicted",
              "archived",
              "deleted"
            ],
            "description": "New lifecycle status."
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Memory ids this replaces."
          },
          "contradicts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Memory ids this contradicts."
          },
          "force": {
            "type": "boolean",
            "description": "Required to set status to \"deleted\" — authorizes all deletions, not just permanent memories. The override is audit-logged."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "otherKeys": [
        "capabilities",
        "category",
        "icon",
        "timeoutMs",
        "usageHint"
      ]
    },
    {
      "name": "memory_delete",
      "description": "Delete one SAGE entry by id (soft-delete with graph/relationship cascade cleanup). Requires force: true — all deletions are audited and need explicit authorization.",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The memory id to delete."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Reason recorded in the audit log."
          },
          "force": {
            "type": "boolean",
            "description": "Required for ALL deletions — authorizes the removal and is recorded in the audit log."
          },
          "neverInject": {
            "type": "boolean",
            "description": "Absolute privacy/safety ban: this memory must never enter LLM context. Normal deletion remains context-eligible historical evidence."
          }
        },
        "required": [
          "id",
          "force"
        ],
        "additionalProperties": false
      },
      "otherKeys": [
        "capabilities",
        "category",
        "icon",
        "timeoutMs",
        "usageHint"
      ]
    },
    {
      "name": "memory_recover",
      "description": "Restore a deleted SAGE entry to active status. Superseded entries resolve to the head of their version chain (no-op write).",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The memory id to recover."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Reason recorded in the audit log."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "otherKeys": [
        "capabilities",
        "category",
        "icon",
        "timeoutMs",
        "usageHint"
      ]
    },
    {
      "name": "memory_backfill_recoverable",
      "description": "Find status=\"deleted\" memories that are still recoverable and either preview them (default) or restore them as fresh active versions.",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "description": "Optional filter — see schema for fields. Empty/missing means \"no filter\".",
            "properties": {
              "kinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "fact",
                    "decision",
                    "convention",
                    "preference",
                    "warning",
                    "anti_pattern",
                    "workflow",
                    "bug_root_cause",
                    "file_note",
                    "symbol_note",
                    "command_note",
                    "summary",
                    "memory_review",
                    "tool_outcome",
                    "error_pattern",
                    "session_digest",
                    "role_operational",
                    "task_outcome",
                    "security_signal",
                    "fleet_convention"
                  ]
                },
                "description": "Only consider memories with one of these kinds."
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "project",
                    "user",
                    "session",
                    "file",
                    "symbol"
                  ]
                },
                "description": "Only consider memories with one of these scopes."
              },
              "updatedAfter": {
                "type": "string",
                "minLength": 1,
                "description": "ISO-8601 cutoff: only memories with updatedAt >= this are considered."
              },
              "updatedBefore": {
                "type": "string",
                "minLength": 1,
                "description": "ISO-8601 cutoff: only memories with updatedAt <= this are considered."
              },
              "requireText": {
                "type": "boolean",
                "description": "Default true. Set false to also consider empty-text records."
              },
              "requireProvenance": {
                "type": "boolean",
                "description": "Default true. Set false to consider records with neither sources nor anchors."
              }
            },
            "additionalProperties": false
          },
          "apply": {
            "type": "boolean",
            "description": "Default false (dry-run). Set true to actually create new active versions."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Optional reason recorded in the audit log."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "otherKeys": [
        "capabilities",
        "category",
        "icon",
        "timeoutMs",
        "usageHint"
      ]
    }
  ]
}
