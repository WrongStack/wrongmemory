        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "otherKeys": [
        "capabilities",
        "category",
        "icon",
        "timeoutMs",
        "usageHint"
      ]
    },
    {
      "name": "forget",
      "description": "Remove memory entries whose text/tag/anchor matches the query (case-insensitive). Requires force: true — this is a bulk delete. Prefer `memory_delete` when you have a specific memory id.",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "description": "Substring/tag/id to match."
