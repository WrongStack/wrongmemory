    {
      "name": "memory_hygiene",
      "description": "Deduplicate, verify anchors, mark stale, supersede old versions, and surface review candidates for deletion or archival. Never auto-deletes live memories — those decisions belong to the user or agent. The optional, opt-in purgeDeletedAfterDays physically compacts ALREADY-deleted tombstones older than N days out of the JSONL log (never touches active or permanent memories).",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "retentionDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 3650
          },
          "archiveLowConfidenceAfterDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 3650
          },
          "verify": {
            "type": "boolean"
          },
          "purgeDeletedAfterDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 3650,
            "description": "OPT-IN cleanup: physically remove records that are already status=\"deleted\" and were deleted more than this many days ago, compacting them out of the JSONL log. Omit or 0 to disable (default). Never deletes active/permanent memories and never creates new deletions. JSONL backend only."
          }
        },
        "additionalProperties": false
