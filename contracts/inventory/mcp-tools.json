    {
      "name": "remember",
      "description": "Persist structured project knowledge into long-term SAGE. Bind it to files, symbols, or commands with `anchors` so it can be verified and auto-surfaced later.",
      "permission": "confirm",
      "riskTier": "standard",
      "mutating": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The fact or note to remember. Concise and factual."
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "decision",
              "convention",
              "preference",
              "warning",
              "anti_pattern",
              "workflow",
              "bug_root_cause",
              "file_note",
              "symbol_note",
              "command_note",
              "summary",
              "memory_review",
              "tool_outcome",
              "error_pattern",
              "session_digest",
              "role_operational",
              "task_outcome",
              "security_signal",
              "fleet_convention"
            ],
            "description": "Category — the most specific kind that fits."
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "user",
              "session",
              "file",
              "symbol"
            ],
            "description": "project (shared, default), user (personal), session, file, or symbol."
          },
          "ownerSessionId": {
            "type": "string",
            "description": "Optional. For scope 'session' the current session is used automatically; pass this only to attribute the memory to a different session. Ignored for non-session scopes."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Hashtag-style tags for grouping and search (omit the #)."
          },
          "anchors": {
            "type": "array",
            "description": "Bind this memory to concrete code locations so it can be verified and auto-surfaced.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "file",
                    "directory",
                    "symbol",
                    "package",
                    "command",
                    "test",
                    "git",
                    "agent"
                  ],
                  "description": "Anchor kind."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Project-relative path (required for file/directory/package/test/git)."
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Symbol name (required for symbol anchors)."
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Shell command (required for command anchors)."
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Roster/catalog role id (required for agent anchors)."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "array",
            "maxItems": 16,
            "description": "Evidence actually inspected. Use session for agent observations; user only for explicit user statements.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "user",
                    "session",
                    "tool_result",
                    "project_instruction",
                    "file",
                    "test",
                    "command",
                    "legacy_memory"
                  ],
                  "description": "Evidence origin."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Source file or test path."
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Command actually run."
                },
                "toolUseId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Observed tool call id."
                },
                "excerptHash": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Hash of inspected evidence, if available."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "validity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement"
            ],
            "description": "When this claim applies. Assumptions are unverified until checked in the current task. Literal source checks are evidence signals, not proof that all assumptions hold. Never include secrets or executable commands.",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "checks": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "path",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "source_contains"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "description": "Relative project file path."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400,
                      "description": "Exact source literal expected while the claim applies; not a regex."
                    }
                  }
                }
              }
            }
          },
          "audience": {
            "type": "object",
            "description": "Optional automatic-injection audience. Values are stable project role/task/mode ids.",
            "properties": {
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Agent role ids, for example reviewer, refactor-planner, or git."
              },
              "taskTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Task classifications such as review, refactor, or bugfix."
              },
              "modes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Runtime mode ids."
              }
            },
            "additionalProperties": false
          },
          "no_auto_audience": {
            "type": "boolean",
            "description": "Set to true to prevent auto-scoping from your agent role. Creates a general project memory even when called from a subagent."
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
